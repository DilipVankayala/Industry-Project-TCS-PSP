{"cells":[{"cell_type":"markdown","source":["**Superstore Profit Analysis**"],"metadata":{"id":"rvgoEj_1Bklh"}},{"cell_type":"code","source":["import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import numpy as np\n","\n","# Load the dataset\n","df = pd.read_csv('Sample - Superstore.csv', encoding='latin-1')\n","\n","# 1. DATA PREPARATION (Cleaning and Feature Engineering)\n","# Convert 'Order Date' to datetime objects\n","df['Order Date'] = pd.to_datetime(df['Order Date'], dayfirst=True, errors='coerce')\n","\n","# Add time-based columns\n","df['Order Year'] = df['Order Date'].dt.year\n","df['Order Quarter'] = df['Order Date'].dt.to_period('Q')\n","df['Order Month'] = df['Order Date'].dt.to_period('M')\n","\n","# Calculate Profit Margin\n","df['Profit Margin'] = df['Profit'] / df['Sales']\n","\n","# 2. ANALYSIS 1: PRODUCT PERFORMANCE\n","print(\"--- 1a. Performance by Product Category (Sorted by Profit) ---\")\n","category_performance = df.groupby('Category').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","category_performance['Profit_Margin'] = category_performance['Total_Profit'] / category_performance['Total_Sales']\n","category_performance = category_performance.sort_values(by='Total_Profit', ascending=False).round(2)\n","print(category_performance.to_markdown(index=False, numalign='left', stralign='left'))\n","\n","\n","print(\"\\n--- 1b. Performance by Product Sub-Category (Sorted by Profit) ---\")\n","sub_category_performance = df.groupby('Sub-Category').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","sub_category_performance['Profit_Margin'] = sub_category_performance['Total_Profit'] / sub_category_performance['Total_Sales']\n","sub_category_performance = sub_category_performance.sort_values(by='Total_Profit', ascending=False).round(2)\n","print(sub_category_performance.to_markdown(index=False, numalign='left', stralign='left'))\n","\n","# 3. ANALYSIS 2: CUSTOMER SEGMENT PERFORMANCE\n","print(\"\\n--- 2. Performance by Customer Segment (Sorted by Profit) ---\")\n","segment_performance = df.groupby('Segment').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","segment_performance['Profit_Margin'] = segment_performance['Total_Profit'] / segment_performance['Total_Sales']\n","segment_performance = segment_performance.sort_values(by='Total_Profit', ascending=False).round(2)\n","print(segment_performance.to_markdown(index=False, numalign='left', stralign='left'))\n","\n","# 4. ANALYSIS 3: TIME SERIES / SEASONALITY (Quarterly)\n","\n","# Aggregate Sales and Profit by Quarter\n","quarterly_performance = df.groupby('Order Quarter').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum')\n",").reset_index()\n","quarterly_performance['Quarter'] = quarterly_performance['Order Quarter'].astype(str)\n","\n","# Plotting the Quarterly Sales Trend\n","plt.figure(figsize=(12, 6))\n","sns.lineplot(x='Quarter', y='Total_Sales', data=quarterly_performance, marker='o', label='Total Sales')\n","sns.lineplot(x='Quarter', y='Total_Profit', data=quarterly_performance, marker='o', label='Total Profit')\n","plt.title('Quarterly Sales and Profit Trend (2014-2017)', fontsize=14)\n","plt.xlabel('Order Quarter', fontsize=12)\n","plt.ylabel('Amount (USD)', fontsize=12)\n","plt.xticks(rotation=45, ha='right')\n","plt.grid(True, linestyle='--', alpha=0.6)\n","plt.legend()\n","plt.tight_layout()\n","plt.savefig('quarterly_sales_profit_trend.png')\n","plt.close()\n","\n","print(\"\\n--- 3. Quarterly Sales and Profit Performance (Plot saved as quarterly_sales_profit_trend.png) ---\")\n","print(quarterly_performance[['Quarter', 'Total_Sales', 'Total_Profit']].round(2).to_markdown(index=False, numalign='left', stralign='left'))\n","\n","# 5. ANALYSIS 4: GEOGRAPHIC PERFORMANCE\n","\n","print(\"\\n--- 4a. Performance by Region (Sorted by Profit) ---\")\n","region_performance = df.groupby('Region').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","region_performance['Profit_Margin'] = region_performance['Total_Profit'] / region_performance['Total_Sales']\n","region_performance = region_performance.sort_values(by='Total_Profit', ascending=False).round(2)\n","print(region_performance.to_markdown(index=False, numalign='left', stralign='left'))\n","\n","print(\"\\n--- 4b. Top 5 Least Profitable Cities (Loss Drivers) ---\")\n","city_performance = df.groupby('City').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","bottom_5_cities = city_performance.sort_values(by='Total_Profit', ascending=True).head(5)\n","bottom_5_cities[['Total_Sales', 'Total_Profit']] = bottom_5_cities[['Total_Sales', 'Total_Profit']].round(2)\n","print(bottom_5_cities.to_markdown(index=False, numalign='left', stralign='left'))\n","\n","# 6. ANALYSIS 5: DISCOUNT IMPACT\n","\n","# Create discount bins\n","bins = [-0.01, 0.001, 0.201, 0.401, 0.601, 1.01]\n","labels = ['0%', '1%-20%', '21%-40%', '41%-60%', '61%+' ]\n","df['Discount_Bin'] = pd.cut(df['Discount'], bins=bins, labels=labels, right=False)\n","\n","discount_analysis = df.groupby('Discount_Bin').agg(\n","    Total_Sales=('Sales', 'sum'),\n","    Total_Profit=('Profit', 'sum'),\n",").reset_index()\n","\n","discount_analysis['Profit_Margin'] = discount_analysis['Total_Profit'] / discount_analysis['Total_Sales']\n","discount_analysis = discount_analysis.sort_values(by='Discount_Bin', ascending=True).round(2)\n","\n","# Plotting the Profit Margin by Discount Bin\n","plt.figure(figsize=(10, 6))\n","sns.barplot(x='Discount_Bin', y='Profit_Margin', data=discount_analysis, palette='viridis')\n","plt.title('Profit Margin by Discount Level', fontsize=14)\n","plt.xlabel('Discount Level', fontsize=12)\n","plt.ylabel('Average Profit Margin', fontsize=12)\n","plt.yticks(rotation=0)\n","plt.grid(axis='y', linestyle='--', alpha=0.6)\n","plt.tight_layout()\n","plt.savefig('profit_margin_by_discount.png')\n","plt.close()\n","\n","print(\"\\n--- 5. Impact of Discount on Profitability (Plot saved as profit_margin_by_discount.png) ---\")\n","print(discount_analysis.to_markdown(index=False, numalign='left', stralign='left'))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Wn06DpOU6Ncw","executionInfo":{"status":"ok","timestamp":1761897845890,"user_tz":-330,"elapsed":1583,"user":{"displayName":"Dilip Vankayala","userId":"07832252939924716204"}},"outputId":"dad23528-4bf8-4c16-b6dd-919cd29cf8a4"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- 1a. Performance by Product Category (Sorted by Profit) ---\n","| Category        | Total_Sales   | Total_Profit   | Profit_Margin   |\n","|:----------------|:--------------|:---------------|:----------------|\n","| Technology      | 836154        | 145456         | 0.17            |\n","| Office Supplies | 719047        | 122491         | 0.17            |\n","| Furniture       | 742000        | 18451.2        | 0.02            |\n","\n","--- 1b. Performance by Product Sub-Category (Sorted by Profit) ---\n","| Sub-Category   | Total_Sales   | Total_Profit   | Profit_Margin   |\n","|:---------------|:--------------|:---------------|:----------------|\n","| Copiers        | 149528        | 55617.9        | 0.37            |\n","| Phones         | 330007        | 44516.2        | 0.13            |\n","| Accessories    | 167380        | 41936.8        | 0.25            |\n","| Paper          | 78479.2       | 34053.3        | 0.43            |\n","| Binders        | 203413        | 30221.6        | 0.15            |\n","| Chairs         | 328449        | 26590.2        | 0.08            |\n","| Storage        | 223844        | 21279          | 0.1             |\n","| Appliances     | 107532        | 18138.1        | 0.17            |\n","| Furnishings